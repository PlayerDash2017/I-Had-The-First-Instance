leaveRoom = false; //Sets whether the camera can follow the player outside of the room's boundaries
screenLock = true; //Whether to snap to screen borders or whether to follow the player
screenWidth = 800; //Used with screenLock
screenHeight = 608;
smoothLerp = 1; //How fast the smooth camera follows the player. (0-1, 1 = instant camera)
zoomFactor = 1; //>1 = zoomed in, <1 = zoomed out

init = false;
targetX = 0;
targetY = 0;

